# Copy to /etc/auracinema/app.env on the EC2 server (chmod 600, root only). NEVER commit the real file.
# Docker --env-file takes values literally: no quotes, and `$` in the bcrypt hash is fine.
APP_NAME=AuraCinema
APP_ENV=production
APP_DEBUG=false
APP_KEY=                     # generate: php artisan key:generate --show  (a NEW one - the old one is public on GitHub)
APP_URL=https://YOUR-CLOUDFRONT-OR-DOMAIN

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=auracinema
DB_USERNAME=aura_user
DB_PASSWORD=                 # a NEW long random password - the old one is public on GitHub

# No database hits for sessions/cache (the default is `database` = 2-3 extra MySQL queries per request)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Admin (add / edit / delete). Hash: php -r "echo password_hash('long-password', PASSWORD_BCRYPT), PHP_EOL;"
ADMIN_USER=nuwan
ADMIN_PASSWORD_HASH=
ADMIN_REQUIRE_HTTPS=true
